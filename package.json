{
  "name": "claw-currentthink-desktop",
  "version": "0.1.0",
  "description": "内置 Claw Code 的中文桌面编程助手，开箱即用支持本地任务、续聊和 OpenAI-compatible 模型。",
  "type": "module",
  "main": "electron/main.cjs",
  "license": "MIT",
  "author": {
    "name": "molcurrent",
    "email": "molcurrent@users.noreply.github.com"
  },
  "homepage": "https://github.com/molcurrent/claw-currentthink-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molcurrent/claw-currentthink-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/molcurrent/claw-currentthink-desktop/issues"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && node scripts/run-electron.cjs .\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "build:claw": "node scripts/build-bundled-claw.cjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node scripts/run-electron.cjs .",
    "dist": "npm run build:claw && npm run build && electron-builder --publish never",
    "dist:mac": "npm run build:claw && npm run build && electron-builder --mac --universal --publish never",
    "dist:linux": "npm run build:claw && npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build:claw && npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@vitejs/plugin-react": "^5.1.2",
    "gpt-tokenizer": "^3.4.0",
    "lowdb": "^7.0.1",
    "lucide-react": "^0.487.0",
    "motion": "^12.23.24",
    "open-cli": "^9.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.12",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.currentthink.clawdesktop",
    "productName": "Claw Currentthink 中文版",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "Claw-Currentthink-${version}-${os}-${arch}.${ext}",
    "asarUnpack": [
      "electron/claw-repl.expect"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "skills/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Claw Currentthink 中文版使用麦克风将语音转写为输入内容。"
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "molcurrent <molcurrent@users.noreply.github.com>",
      "category": "Development"
    }
  }
}
